{
  "name": "magic-backup-importer",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "build": "vite build",
    "deploy": "CLOUDFLARE_ENV=production vite build && wrangler deploy",
    "deploy-preview": "CLOUDFLARE_ENV=preview vite build && wrangler deploy",
    "dev": "vite dev",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@react-router/cloudflare": "^7.0.0",
    "idb": "^8.0.0",
    "isbot": "^4.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/workers-types": "^4.20240405.0",
    "@react-router/dev": "^7.0.0",
    "@react-router/fs-routes": "^7.0.0",
    "@types/react": "^18.2.20",
    "@types/react-dom": "^18.2.7",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.1.6",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
